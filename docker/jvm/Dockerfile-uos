# syntax=docker/dockerfile:1
# check=skip=SecretsUsedInArgOrEnv
#
# 参考官方镜像: https://github.com/apache/kafka (docker/jvm/Dockerfile)
# 官方基于 eclipse-temurin:25-jre-alpine，本文件适配 UOS Server 20 1070a (yum/dnf)
#
# 与官方的主要差异:
#   1. 基础镜像: eclipse-temurin:25-jre-alpine (Alpine) → ghcr.io/blueapple168/uos-server-20-1070a:latest
#      (UOS Server 20, RHEL 8 兼容, glibc 2.28)
#   2. JRE/JDK 来源: Temurin 容器内置 → 清华镜像 Adoptium tarball 离线解压到 /usr/lib/jvm/
#      https://mirrors.tuna.tsinghua.edu.cn/Adoptium/25/jdk/<arch>/    (JDK, 第一阶段用)
#      https://mirrors.tuna.tsinghua.edu.cn/Adoptium/25/jre/<arch>/    (JRE, 运行时阶段用)
#      第一阶段用 JDK (生成 jsa 需要 java/javac 等工具)，运行时阶段用 JRE (节省 ~100MB 体积)
#   3. 包管理: apk add → yum install,所有 yum 操作合并到单次 RUN (UOS 全部仓库元数据约 60s/次)
#   4. Alpine adduser -D → shadow-utils 的 useradd -r -u 1000
#   5. 时区与编码: 增加 TZ=Asia/Shanghai + LANG=C.UTF-8 (避免 latin1 编码告警)
#   6. Temurin tarball 校验: ARG SHA256 摘要 (类似 rabbitmq/erlang-rpm 模式，参考 RabbitMQ UOS 示例)
#   7. Kafka tarball 校验沿用官方 .asc PGP 签名 + 完成后 rpm -e gnupg2 减小镜像体积
#
# 构建流程 (两阶段,保留官方 CDS 优化):
#   Stage 1 (AS build-jsa):
#     -> 装 Temurin JDK 25 -> 解压 Kafka -> 跑 jsa_launch 生成 kafka.jsa + storage.jsa
#   Stage 2 (runtime):
#     -> 装 Temurin JRE 25 -> 解压 Kafka -> COPY 启动脚本与配置 -> COPY --from=build-jsa *.jsa
#     -> 创建 appuser 与目录 -> 切换 USER appuser -> CMD /etc/kafka/docker/run
#
# 版本对齐: OpenJDK 25.0.x 对齐官方 eclipse-temurin:25-jre-alpine (Kafka 4.x 要求 Java 17+)

ARG KAFKA_VERSION=4.3.1
ARG BASE_IMAGE_TAG=uos-server-20-1070a:latest
# 版本号需与清华镜像 Adoptium/25 目录下实际存在的 tarball 完全一致,
# 否则 wget 会 404。当前镜像上提供的是 25.0.5_8 (见目录页 / SHA256SUMS)。
# 注意: 该镜像会随上游发布轮转补丁版本 (25.0.4.1_1 -> 25.0.5_8 即导致过一次 CI 构建失败),
# 因此 CI 构建时由 workflow 的 "Resolve Temurin version and checksums" 步骤动态解析并通过
# --build-arg 覆盖下面两个 ARG; 这里的默认值只用于本地手动 docker build。
ARG JDK_VERSION=25.0.5_8
ARG JRE_VERSION=25.0.5_8

# Adoptium OpenJDK 25 tarball 的清华镜像路径 (无 .asc 签名文件，使用 ARG SHA256 摘要校验)
# 摘要由 CI 自动解析后注入 (workflow "Resolve Temurin version and checksums" 通过 --build-arg 透传),
# 仓库 Secrets 仅作兜底:
#   JDK_TARBALL_SHA256_X86_64 / JDK_TARBALL_SHA256_AARCH64
#   JRE_TARBALL_SHA256_X86_64 / JRE_TARBALL_SHA256_AARCH64
# 升级 JDK_VERSION / JRE_VERSION 时, CI 会自动跟随镜像实际版本, 无需手工同步摘要
# 摘要取自 Adoptium 官方 API (v3/assets/release_name) 或 release notes:
#   https://api.adoptium.net/v3/assets/release_name/eclipse/jdk-<version with +>
#   ${JAVA_MIRROR_BASE_URL}/${JDK_SUBDIR}/<arch>/linux/...
ARG JDK_TARBALL_SHA256_X86_64=""
ARG JDK_TARBALL_SHA256_AARCH64=""
ARG JRE_TARBALL_SHA256_X86_64=""
ARG JRE_TARBALL_SHA256_AARCH64=""

# 通用 base URL (清华镜像,可通过 --build-arg 覆盖为华为云/阿里云等)
# 完整 tarball URL = ${JAVA_MIRROR_BASE_URL}/${JDK_SUBDIR | JRE_SUBDIR}/<arch>/<tarball>
#   清华: JAVA_MIRROR_BASE_URL=https://mirrors.tuna.tsinghua.edu.cn/Adoptium/25  + JDK_SUBDIR=jdk / JRE_SUBDIR=jre
#   华为云: JAVA_MIRROR_BASE_URL=https://repo.huaweicloud.com/java/jdk/Adoptium/25 + 子目录保持 jdk/jre
ARG JAVA_MIRROR_BASE_URL=https://mirrors.tuna.tsinghua.edu.cn/Adoptium/25
ARG JDK_SUBDIR=jdk
ARG JRE_SUBDIR=jre

############################################
# Stage 1: build-jsa — 生成 kafka.jsa / storage.jsa
############################################

FROM ghcr.io/blueapple168/${BASE_IMAGE_TAG} AS build-jsa

ARG KAFKA_VERSION
ARG JDK_VERSION
ARG JDK_TARBALL_SHA256_X86_64
ARG JDK_TARBALL_SHA256_AARCH64
ARG JAVA_MIRROR_BASE_URL
ARG JDK_SUBDIR
ARG kafka_url=""

LABEL stage=build-jsa

ENV TZ=Asia/Shanghai
ENV LANG=C.UTF-8 LANGUAGE=C.UTF-8 LC_ALL=C.UTF-8

# 单次 yum 会话: 调优 + 运行时依赖 + 清理
RUN set -eux; \
    echo "${TZ}" > /etc/timezone; \
    sed -i 's/\$StateMode/ufu/g' /etc/yum.repos.d/UnionTechOS.repo; \
    sed -i 's/Version: 39\.2\.0/Version: 2026.10.10/g' /usr/lib/python3.6/site-packages/setuptools-39.2.0.dist-info/METADATA 2>/dev/null || true; \
    \
    : "=== yum/dnf 网络调优：默认 timeout=30s 太短，minrate=1000 容易在低速链路上触发下载中止 ===" ; \
    : "境外 runner (尤其 arm64 QEMU) 访问 UOS 官方源常出现 SSL 断连(35)/空响应(52)/低速超时(28)," ; \
    : "故 minrate 放宽到 0 (不因低速中止), timeout 提到 600s, 并开启 curl 层重试" ; \
    if [ -f /etc/yum.conf ]; then \
        sed -i '/^[ \t]*\(timeout\|minrate\|retries\)=/d' /etc/yum.conf 2>/dev/null || true; \
        if grep -q '^\[main\]' /etc/yum.conf; then \
            sed -i '/^\[main\]/a timeout=600\nminrate=0\nretries=10' /etc/yum.conf; \
        else \
            printf '\n[main]\ntimeout=600\nminrate=0\nretries=10\n' >> /etc/yum.conf; \
        fi; \
    fi; \
    \
    : "=== 运行时依赖 (build-jsa 阶段也需要): ca-certificates (TLS)、wget/curl (下载)、tar/xz (解压)、findutils+coreutils、bash ===" ; \
    : "带指数退避的重试循环: 最多 3 轮, 覆盖 makecache + install 全流程" ; \
    pkgs='ca-certificates tar xz wget curl bash procps gnupg2 findutils shadow-utils hostname'; \
    ok=0; \
    for attempt in 1 2 3; do \
        echo "::notice::yum 安装尝试 ${attempt}/3 (packages: ${pkgs})"; \
        if yum makecache --setopt=timeout=600 --setopt=minrate=0 --setopt=retries=10 \
           && yum install -y --setopt=install_weak_deps=false --nogpgcheck --nodocs \
                --setopt=timeout=600 --setopt=minrate=0 --setopt=retries=10 \
                ${pkgs}; then \
            ok=1; echo "::notice::yum 安装成功 (尝试 ${attempt})"; break; \
        fi; \
        echo "::warning::yum 第 ${attempt} 轮失败, 清理缓存后重试"; \
        yum clean all 2>/dev/null || true; rm -rf /var/cache/yum /var/cache/dnf 2>/dev/null || true; \
        sleep $((attempt * 15)); \
    done; \
    if [ "${ok}" != "1" ]; then echo "::error::yum 安装 3 轮均失败"; exit 1; fi; \
    \
    : "=== 按架构下载 Temurin JDK 25 tarball 并校验 ===" ; \
    case "$(uname -m)" in \
        x86_64)  jdkArch='x64';      jdkSha="${JDK_TARBALL_SHA256_X86_64}" ;; \
        aarch64) jdkArch='aarch64';  jdkSha="${JDK_TARBALL_SHA256_AARCH64}" ;; \
        *) echo >&2 "error: unsupported arch: '$(uname -m)'"; exit 1 ;; \
    esac; \
    JDK_TARBALL_NAME="OpenJDK25U-jdk_${jdkArch}_linux_hotspot_${JDK_VERSION}.tar.gz"; \
    JDK_TARBALL_URL="${JAVA_MIRROR_BASE_URL}/${JDK_SUBDIR}/${jdkArch}/linux/${JDK_TARBALL_NAME}"; \
    JDK_INSTALL_DIR="/usr/lib/jvm"; \
    JAVA_HOME="/usr/lib/jvm/java"; \
    \
    : "=== wget --progress dot:giga 下载 tarball (带 5 次重试, 境外链路易断) ===" ; \
    wget --progress dot:giga --tries=5 --timeout=300 --waitretry=10 --retry-connrefused \
         --output-document "/tmp/${JDK_TARBALL_NAME}" "$JDK_TARBALL_URL" \
      || { echo >&2 "error: Temurin JDK 下载失败: ${JDK_TARBALL_URL}"; \
           echo >&2 "hint: 镜像可能已轮转到新补丁版本, 请更新 JDK_VERSION 或让 CI 自动解析"; exit 1; }; \
    \
    : "=== SHA256 校验: 摘要取自 Adoptium 官方 (无 .asc 资产,这是官方提供的唯一校验手段) ===" ; \
    : "摘要为空时(未配置 Secrets 且 CI 未解析)只告警不中断, 便于本地手动构建" ; \
    if [ -n "${jdkSha}" ]; then \
        echo "${jdkSha}  /tmp/${JDK_TARBALL_NAME}" | sha256sum --check --strict -; \
    else \
        echo >&2 "warning: 未提供 JDK_TARBALL_SHA256, 跳过校验"; \
    fi; \
    \
    : "=== 解压 Temurin JDK 到 /usr/lib/jvm,探测顶层目录名 ===" ; \
    mkdir -p "$JDK_INSTALL_DIR"; \
    JDK_DIR=$(tar -tzf "/tmp/${JDK_TARBALL_NAME}" | head -n1 | cut -d/ -f1); \
    tar -xzf "/tmp/${JDK_TARBALL_NAME}" -C "$JDK_INSTALL_DIR/"; \
    ln -sfn "${JDK_INSTALL_DIR}/${JDK_DIR}" "${JAVA_HOME}"; \
    rm -f "/tmp/${JDK_TARBALL_NAME}"; \
    \
    : "=== update-alternatives 注册 java/javac/jar/jps ===" ; \
    update-alternatives --install /usr/bin/java  java  "${JAVA_HOME}/bin/java"  1000; \
    update-alternatives --install /usr/bin/javac javac "${JAVA_HOME}/bin/javac" 1000; \
    update-alternatives --install /usr/bin/jar   jar   "${JAVA_HOME}/bin/jar"   1000; \
    update-alternatives --install /usr/bin/jps   jps   "${JAVA_HOME}/bin/jps"   1000; \
    \
    : "=== 冒烟测试: java -version ===" ; \
    java -version; \
    \
    yum clean all; \
    rm -rf /var/cache/yum /var/cache/dnf

ENV JAVA_HOME=/usr/lib/jvm/java
ENV PATH=$JAVA_HOME/bin:$PATH

# 准备 Kafka 二进制 (build-jsa 阶段需要完整 Kafka 才能跑 jsa_launch)
#
# 注意: COPY 会保留源文件的权限位。docker/jsa_launch 在 git 中以 100755 存储
# (有执行位), 但为防 checkout 到不支持 x 位的文件系统 / CI 缓存导致权限丢失,
# 下面显式 chmod 0755 —— 否则 RUN /etc/kafka/docker/jsa_launch 会报
#   "/bin/sh: /etc/kafka/docker/jsa_launch: Permission denied" (exit 126)。
COPY jsa_launch /etc/kafka/docker/jsa_launch
COPY launch     /etc/kafka/docker/launch
COPY server.properties /etc/kafka/docker/server.properties
RUN chmod 0755 /etc/kafka/docker/jsa_launch /etc/kafka/docker/launch
# context 根由 workflow 预置了 kafka.tgz 占位文件 (touch docker/kafka.tgz),
# 使本行 glob 能匹配; 真正的 tarball 由下面的 RUN 用 wget 覆盖下载。
COPY *kafka.tgz kafka.tgz

RUN set -eux; \
    mkdir -p /opt/kafka; \
    if [ -n "$kafka_url" ]; then \
        : "=== 从 URL 下载 Kafka tarball + .asc PGP 签名 ===" ; \
        wget --progress dot:giga --output-document kafka.tgz "$kafka_url"; \
        wget --progress dot:giga --output-document kafka.tgz.asc "$kafka_url.asc"; \
        \
        : "=== PGP 校验: 下载 Apache 官方 KEYS 并导入全部签名公钥 ===" ; \
        : "不用 keyserver: hkps://keys.openpgp.org 对未公开邮箱的 key 返回 No data;" ; \
        : "改为信任 Apache 官方发布渠道的 KEYS 文件 (含全部 Release Manager 公钥)。" ; \
        KEYS_OK=0; \
        for u in \
            https://archive.apache.org/dist/kafka/KEYS \
            https://downloads.apache.org/kafka/KEYS \
            https://dlcdn.apache.org/kafka/KEYS \
            https://mirrors.tuna.tsinghua.edu.cn/apache/kafka/KEYS \
            https://mirrors.aliyun.com/apache/kafka/KEYS \
        ; do \
            if wget --progress dot:giga --timeout=30 --tries=2 --output-document KEYS "$u" 2>/dev/null \
               && grep -q "BEGIN PGP PUBLIC KEY BLOCK" KEYS; then \
                echo "KEYS 下载成功: $u"; KEYS_OK=1; break; \
            fi; \
            echo "KEYS 下载失败或内容非 PGP, 尝试下一个镜像: $u"; \
        done; \
        [ "$KEYS_OK" = "1" ] || { echo "错误: 所有镜像均无法获取有效 Apache KEYS 文件"; exit 1; }; \
        export GNUPGHOME="$(mktemp -d)"; \
        gpg --batch --import KEYS; \
        gpg --batch --verify kafka.tgz.asc kafka.tgz; \
        gpgconf --kill all; \
        rm -rf "$GNUPGHOME"; \
        rm -f KEYS; \
    fi; \
    : "=== 解压 Kafka 到 /opt/kafka (strip-components=1 去掉顶层目录) ===" ; \
    tar xfz kafka.tgz -C /opt/kafka --strip-components 1; \
    rm -f kafka.tgz kafka.tgz.asc

# 生成 jsa 归档 (kafka.jsa 与 storage.jsa, 落在 /opt/kafka 下)
# 脚本失败时立即中断构建, 避免 Stage 2 的 COPY --from 才报 "not found"。
RUN /etc/kafka/docker/jsa_launch \
    && ls -l /opt/kafka/kafka.jsa /opt/kafka/storage.jsa

############################################
# Stage 2: runtime — 最终运行镜像
############################################

FROM ghcr.io/blueapple168/${BASE_IMAGE_TAG}

ARG KAFKA_VERSION
ARG JRE_VERSION
ARG JRE_TARBALL_SHA256_X86_64
ARG JRE_TARBALL_SHA256_AARCH64
ARG JAVA_MIRROR_BASE_URL
ARG JRE_SUBDIR
ARG kafka_url=""
ARG build_date

LABEL maintainer="blueapple" \
        version="1.0" \
        description="Apache Kafka ${KAFKA_VERSION} (KRaft) on UOS 1070a with Temurin JRE ${JRE_VERSION}" \
        org.opencontainers.image.base.name="registry.uniontech.com/uos-server-base/uos-server-20-1070a:latest" \
        org.opencontainers.image.title="Apache Kafka" \
        org.opencontainers.image.version="${KAFKA_VERSION}" \
        org.opencontainers.image.authors="Apache Kafka" \
        org.label-schema.name="kafka" \
        org.label-schema.description="Apache Kafka" \
        org.label-schema.build-date="${build_date}" \
        org.label-schema.vcs-url="https://github.com/apache/kafka"

ENV TZ=Asia/Shanghai
ENV LANG=C.UTF-8 LANGUAGE=C.UTF-8 LC_ALL=C.UTF-8

# Kafka broker PLAINTEXT (9092) 与 controller (9093, KRaft 模式)
EXPOSE 9092 9093

USER root

# 运行时阶段只需 JRE (节省 ~100MB 体积); 但仍走单次 yum 会话合并策略
RUN set -eux; \
    echo "${TZ}" > /etc/timezone; \
    sed -i 's/\$StateMode/ufu/g' /etc/yum.repos.d/UnionTechOS.repo; \
    sed -i 's/Version: 39\.2\.0/Version: 2026.10.10/g' /usr/lib/python3.6/site-packages/setuptools-39.2.0.dist-info/METADATA 2>/dev/null || true; \
    \
    : "=== yum/dnf 网络调优 (境外 runner 访问 UOS 源易断, minrate=0 不因低速中止) ===" ; \
    if [ -f /etc/yum.conf ]; then \
        sed -i '/^[ \t]*\(timeout\|minrate\|retries\)=/d' /etc/yum.conf 2>/dev/null || true; \
        if grep -q '^\[main\]' /etc/yum.conf; then \
            sed -i '/^\[main\]/a timeout=600\nminrate=0\nretries=10' /etc/yum.conf; \
        else \
            printf '\n[main]\ntimeout=600\nminrate=0\nretries=10\n' >> /etc/yum.conf; \
        fi; \
    fi; \
    \
    : "=== 运行时依赖: 官方 Alpine 镜像依赖全部覆盖; shadow-utils 用于 useradd ===" ; \
    : "带指数退避的重试循环: 最多 3 轮" ; \
    pkgs='ca-certificates tar xz wget curl bash procps gnupg2 findutils shadow-utils hostname coreutils'; \
    ok=0; \
    for attempt in 1 2 3; do \
        echo "::notice::yum 安装尝试 ${attempt}/3 (packages: ${pkgs})"; \
        if yum makecache --setopt=timeout=600 --setopt=minrate=0 --setopt=retries=10 \
           && yum install -y --setopt=install_weak_deps=false --nogpgcheck --nodocs \
                --setopt=timeout=600 --setopt=minrate=0 --setopt=retries=10 \
                ${pkgs}; then \
            ok=1; echo "::notice::yum 安装成功 (尝试 ${attempt})"; break; \
        fi; \
        echo "::warning::yum 第 ${attempt} 轮失败, 清理缓存后重试"; \
        yum clean all 2>/dev/null || true; rm -rf /var/cache/yum /var/cache/dnf 2>/dev/null || true; \
        sleep $((attempt * 15)); \
    done; \
    if [ "${ok}" != "1" ]; then echo "::error::yum 安装 3 轮均失败"; exit 1; fi; \
    \
    : "=== 按架构下载 Temurin JRE 25 tarball 并校验 ===" ; \
    case "$(uname -m)" in \
        x86_64)  jreArch='x64';      jreSha="${JRE_TARBALL_SHA256_X86_64}" ;; \
        aarch64) jreArch='aarch64';  jreSha="${JRE_TARBALL_SHA256_AARCH64}" ;; \
        *) echo >&2 "error: unsupported arch: '$(uname -m)'"; exit 1 ;; \
    esac; \
    JRE_TARBALL_NAME="OpenJDK25U-jre_${jreArch}_linux_hotspot_${JRE_VERSION}.tar.gz"; \
    JRE_TARBALL_URL="${JAVA_MIRROR_BASE_URL}/${JRE_SUBDIR}/${jreArch}/linux/${JRE_TARBALL_NAME}"; \
    JDK_INSTALL_DIR="/usr/lib/jvm"; \
    JAVA_HOME="/usr/lib/jvm/java"; \
    \
    wget --progress dot:giga --tries=5 --timeout=300 --waitretry=10 --retry-connrefused \
         --output-document "/tmp/${JRE_TARBALL_NAME}" "$JRE_TARBALL_URL" \
      || { echo >&2 "error: Temurin JRE 下载失败: ${JRE_TARBALL_URL}"; \
           echo >&2 "hint: 镜像可能已轮转到新补丁版本, 请更新 JRE_VERSION 或让 CI 自动解析"; exit 1; }; \
    if [ -n "${jreSha}" ]; then \
        echo "${jreSha}  /tmp/${JRE_TARBALL_NAME}" | sha256sum --check --strict -; \
    else \
        echo >&2 "warning: 未提供 JRE_TARBALL_SHA256, 跳过校验"; \
    fi; \
    \
    mkdir -p "$JDK_INSTALL_DIR"; \
    JRE_DIR=$(tar -tzf "/tmp/${JRE_TARBALL_NAME}" | head -n1 | cut -d/ -f1); \
    tar -xzf "/tmp/${JRE_TARBALL_NAME}" -C "$JDK_INSTALL_DIR/"; \
    ln -sfn "${JDK_INSTALL_DIR}/${JRE_DIR}" "${JAVA_HOME}"; \
    rm -f "/tmp/${JRE_TARBALL_NAME}"; \
    \
    : "=== update-alternatives 注册 java (JRE 阶段无需 javac/jar/jps) ===" ; \
    update-alternatives --install /usr/bin/java  java  "${JAVA_HOME}/bin/java"  1000; \
    \
    : "=== 冒烟测试: java -version ===" ; \
    java -version; \
    \
    yum clean all; \
    rm -rf /var/cache/yum /var/cache/dnf

ENV JAVA_HOME=/usr/lib/jvm/java
ENV PATH=$JAVA_HOME/bin:$PATH

# 准备 Kafka 二进制 + .asc PGP 校验 (与官方 Alpine Dockerfile 等价)
COPY *kafka.tgz kafka.tgz

RUN set -eux; \
    mkdir -p /opt/kafka; \
    if [ -n "$kafka_url" ]; then \
        wget --progress dot:giga --output-document kafka.tgz "$kafka_url"; \
        wget --progress dot:giga --output-document kafka.tgz.asc "$kafka_url.asc"; \
        \
        : "=== PGP 校验: 同 Stage 1, 用 Apache 官方 KEYS 文件导入公钥 ===" ; \
        KEYS_OK=0; \
        for u in \
            https://archive.apache.org/dist/kafka/KEYS \
            https://downloads.apache.org/kafka/KEYS \
            https://dlcdn.apache.org/kafka/KEYS \
            https://mirrors.tuna.tsinghua.edu.cn/apache/kafka/KEYS \
            https://mirrors.aliyun.com/apache/kafka/KEYS \
        ; do \
            if wget --progress dot:giga --timeout=30 --tries=2 --output-document KEYS "$u" 2>/dev/null \
               && grep -q "BEGIN PGP PUBLIC KEY BLOCK" KEYS; then \
                echo "KEYS 下载成功: $u"; KEYS_OK=1; break; \
            fi; \
            echo "KEYS 下载失败或内容非 PGP, 尝试下一个镜像: $u"; \
        done; \
        [ "$KEYS_OK" = "1" ] || { echo "错误: 所有镜像均无法获取有效 Apache KEYS 文件"; exit 1; }; \
        export GNUPGHOME="$(mktemp -d)"; \
        gpg --batch --import KEYS; \
        gpg --batch --verify kafka.tgz.asc kafka.tgz; \
        gpgconf --kill all; \
        rm -rf "$GNUPGHOME"; \
        rm -f KEYS; \
    fi; \
    : "=== 解压 Kafka 到 /opt/kafka (strip-components=1 去掉顶层目录) ===" ; \
    tar xfz kafka.tgz -C /opt/kafka --strip-components 1; \
    rm -f kafka.tgz kafka.tgz.asc; \
    \
    : "=== 卸载 gnupg2 (校验已完成; rpm -e 避免 yum 再拉一次仓库元数据) ===" ; \
    rpm -e gnupg2 2>/dev/null || echo "Notice: gnupg2 was not removed (可能被基础镜像预装且被依赖)"; \
    \
    : "=== 创建 Kafka 运行时目录与 appuser 系统用户 ===" ; \
    mkdir -p /var/lib/kafka/data /etc/kafka/secrets /etc/kafka/docker /usr/logs /mnt/shared/config; \
    if ! getent group appuser >/dev/null; then \
        if getent group 1000 >/dev/null; then \
            echo "::notice GID 1000 已被基础镜像占用,改用系统自动分配"; \
            groupadd --system appuser; \
        else \
            groupadd --gid 1000 --system appuser; \
        fi; \
    fi; \
    if ! id appuser >/dev/null 2>&1; then \
        if id -u 1000 >/dev/null 2>&1; then \
            echo "::notice UID 1000 已被基础镜像占用,改用系统自动分配"; \
            useradd --system --home-dir /home/appuser --gid appuser appuser; \
        else \
            useradd --uid 1000 --system --home-dir /home/appuser --gid appuser appuser; \
        fi; \
    fi; \
    chown -R appuser:appuser /usr/logs /opt/kafka /mnt/shared/config; \
    chown -R appuser:root    /var/lib/kafka /etc/kafka/secrets /etc/kafka; \
    chmod -R ug+w /etc/kafka /var/lib/kafka /etc/kafka/secrets; \
    \
    : "=== 拷贝 log4j 配置到 docker 配置目录 ===" ; \
    cp /opt/kafka/config/log4j2.yaml          /etc/kafka/docker/log4j2.yaml; \
    cp /opt/kafka/config/tools-log4j2.yaml    /etc/kafka/docker/tools-log4j2.yaml; \
    \
    : "=== 创建默认 /home/appuser 与 bash profile (官方 Alpine 用 -h /home/appuser) ===" ; \
    mkdir -p /home/appuser; \
    chown appuser:appuser /home/appuser; \
    echo '. ~/.bashrc' > /home/appuser/.bash_profile; \
    echo '. /etc/profile' > /home/appuser/.bashrc

# Kafka 启动脚本与配置 (沿用官方 common-scripts → configure → launch 链)
COPY server.properties /etc/kafka/docker/server.properties
# 注意: COPY --from=<stage> 的源路径相对的是该 stage 的 WORKDIR (未设置时为 /),
# 官方 Dockerfile 写 `COPY --from=build-jsa kafka.jsa` 是因为官方 jsa_launch
# 把归档输出到 CWD(=/)。本 Dockerfile 的 jsa_launch 输出到 /opt/kafka/,
# 因此这里必须用绝对路径, 否则报: "/kafka.jsa": not found。
COPY --from=build-jsa /opt/kafka/kafka.jsa    /opt/kafka/kafka.jsa
COPY --from=build-jsa /opt/kafka/storage.jsa  /opt/kafka/storage.jsa
COPY --chown=appuser:appuser resources/common-scripts /etc/kafka/docker
COPY --chown=appuser:appuser launch              /etc/kafka/docker/launch
# 显式补执行位: CMD 直接执行 /etc/kafka/docker/run, 权限位丢失会报 126。
# launch 由 run 用 '. ' (source) 加载, 不需要 x 位, 但一并补上无害。
RUN chmod 0755 /etc/kafka/docker/run /etc/kafka/docker/configure \
               /etc/kafka/docker/configureDefaults /etc/kafka/docker/launch

USER appuser

# 数据/配置/证书目录建议挂载卷 (与官方一致)
VOLUME ["/etc/kafka/secrets", "/var/lib/kafka/data", "/mnt/shared/config"]

CMD ["/etc/kafka/docker/run"]
